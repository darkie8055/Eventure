rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // DEVELOPMENT MODE RULES - USE PROPER RULES IN PRODUCTION
    // These rules are more permissive for development purposes
    
    // Helper functions for authentication and authorization
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // During development, allow read access to authenticated users
    match /{document=**} {
      allow read: if isAuthenticated();
    }
    
    // User management rules - more permissive for development
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isAuthenticated();
      
      // Allow creating/updating user profiles during development
      allow write: if isAuthenticated();
    }

    // College rules
    match /colleges/{collegeId} {
      // All authenticated users can read college information
      allow read: if isAuthenticated();
      
      // For development, allow authenticated users to write
      allow write: if isAuthenticated();
    }

    // Community rules
    match /communities/{communityId} {
      // All authenticated users can read communities
      allow read: if isAuthenticated();
      
      // For development, allow authenticated users to write
      allow write: if isAuthenticated();
      
      // Allow access to subcollections
      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Event rules
    match /events/{eventId} {
      // All authenticated users can read events
      allow read: if isAuthenticated();
      
      // For development, allow authenticated users to write
      allow write: if isAuthenticated();
      
      // Allow access to subcollections
      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Allow authenticated users to read/write user subcollections
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}